.DS_Store
*.d
*.o
**/.theos/
**/packages/*
!**/packages/*.deb
**/dist/*
!**/dist/*.ipa
!**/dist/SHA256SUMS
games/*/Tests/rules-tests
apps/*/Tests/rules-tests
apps/*/Tests/stream-tests
# Candidate card sets are regenerated by scripts/make-card-svgs.py; only the shipped one is kept.
games/solitaire/docs/card-designs/sets/*/
!games/solitaire/docs/card-designs/sets/traditional/
# Rent Trivia: source/generated artwork and the private Jellyfin configuration stay local.
# Public release packages may contain artwork, but must never contain Jellyfin.plist.
games/rent-trivia/art/
games/rent-trivia/Resources/Media/
games/rent-trivia/Resources/Icon-76*.png
games/rent-trivia/Resources/Jellyfin.plist

# Python tooling intermediates
**/__pycache__/
*.pyc

# TV private provisioning lives on-device or outside the checkout, never in releases.
**/com.local.iptv.configuration.plist
apps/iptv/Resources/*.local.plist
